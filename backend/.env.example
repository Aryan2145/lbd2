DATABASE_URL=postgresql://user:password@your-rds-host:5432/lbd_db
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000
PORT=4000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a DIFFERENT key locally vs production. Never commit a real key.
ENCRYPTION_KEY=replace-with-64-char-hex

# SMTP — Google Workspace, for email OTP (verification + password reset).
# Generate a Google App Password for noreply@rgbindia.com (requires 2-Step
# Verification) and put it in SMTP_PASS. Leave SMTP_USER/SMTP_PASS blank in dev
# to disable sending — OTP codes are logged to the backend console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@rgbindia.com
SMTP_PASS=your-google-app-password
MAIL_FROM=Life By Design <noreply@rgbindia.com>

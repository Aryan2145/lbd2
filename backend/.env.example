DATABASE_URL=postgresql://user:password@your-rds-host:5432/lbd_db
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000
PORT=4000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a DIFFERENT key locally vs production. Never commit a real key.
ENCRYPTION_KEY=replace-with-64-char-hex

# SMTP for transactional email (password-reset OTP), via Gmail / Google Workspace.
# SMTP_PASS is a Google App Password (not the account login password). Leave it
# blank to log the OTP to the backend console instead of emailing it (dev).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=noreply@rgbindia.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=noreply@rgbindia.com
